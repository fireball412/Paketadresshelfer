{
  "manifest_version": 3,
  "name": "Paketadresshelfer",
  "version": "1.3.0",
  "description": "Übernimmt lokal eine deutsche Empfängeradresse in DHL-Formularfelder, auch mit gemeinsamem Namensfeld.",
  "content_scripts": [
    {
      "matches": [
        "https://dhl.de/*",
        "https://*.dhl.de/*"
      ],
      "js": [
        "src/addressParser.js",
        "src/config.js",
        "src/formDetector.js",
        "src/formFiller.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "diagnostics.html",
    "default_title": "Paketadresshelfer: Diagnose"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ]
}
